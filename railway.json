{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "preDeployCommand": ["npm run migrate"],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
