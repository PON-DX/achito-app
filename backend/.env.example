# Copy to backend/.env for local development. Never commit real values.

# Port to listen on (Railway sets this automatically)
PORT=5000

# Postgres connection string (required). On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/amulet_shop
# SSL is disabled automatically for localhost; set to false to force it off elsewhere
# DATABASE_SSL=false

# Secret used to sign login tokens (required) — use a long random string
JWT_SECRET=

# Admin account created on first start if missing (always set a strong password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
